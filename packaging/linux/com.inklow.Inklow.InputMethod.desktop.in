[Desktop Entry]
Type=Application
Name=BroTypist
GenericName=Predictive typing input method
Comment=Local predictions for supported KDE Wayland text inputs
Exec=@EXEC@ --wayland-input-method --background
Icon=@ICON@
Terminal=false
NoDisplay=true
X-KDE-Wayland-VirtualKeyboard=true
X-Inklow-Owned=true
