# Desktop launcher template; build/package tools supply the executable and icon.
[Desktop Entry]
Type=Application
Name=BroTypist
GenericName=Predictive typing
Comment=Private, local-first writing assistance
Exec=@EXEC@
Icon=@ICON@
Terminal=false
Categories=Utility;Office;
X-KDE-Wayland-Interfaces=org_kde_plasma_window_management
StartupNotify=true
StartupWMClass=BroTypist
