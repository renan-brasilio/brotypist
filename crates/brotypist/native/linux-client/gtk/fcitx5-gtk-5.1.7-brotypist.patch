+// Opted-in synchronous/native dispatch may reenter application callbacks.
+// Keep the original IM context alive until the entire originating frame ends.
+struct BrotypistContextHold {
+    FcitxIMContext *context;
+    explicit BrotypistContextHold(FcitxIMContext *c)
+        : context(c && c->brotypist ? static_cast<FcitxIMContext *>(g_object_ref(c)) : nullptr) {}
+    ~BrotypistContextHold() { if (context) g_object_unref(context); }
+};
+
+// Metadata-only activity extraction from the actual Fcitx signal payload.
+// Do not copy, retain or transmit user preedit/auxiliary text.
+static bool brotypist_formatted_active(GPtrArray *items) {
+    if (!items) return false;
+    for (guint i = 0; i < items->len; ++i) {
+        auto *item = static_cast<FcitxGPreeditItem *>(g_ptr_array_index(items, i));
+        if (item && item->string && item->string[0]) return true;
+    }
+    return false;
+}
 
